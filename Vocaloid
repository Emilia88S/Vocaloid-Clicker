<script>

/* =========================================================
   GAME VARIABLES
========================================================= */

let money = 0;

let speed = 1;

const MAX_SPEED = 100000;

let autoClickUnlocked = false;

let upgradeLevel = 0;

let equippedCharacter = "Hatsune Miku";

let ownedCharacters = ["Hatsune Miku"];


/* =========================================================
   MONEY DISPLAY
========================================================= */

function updateMoney() {

    document.getElementById("money").textContent =
        "$" + Math.floor(money).toLocaleString();

}


/* =========================================================
   CHARACTER CLICK
========================================================= */

function clickCharacter(event) {

    /*
        $10 base reward × speed
    */

    const earnings = 10 * speed;

    money += earnings;

    updateMoney();

    createFloatingMoney(
        event.clientX,
        event.clientY,
        "+" + formatMoney(earnings)
    );

    createParticles(event.clientX, event.clientY);

}


/* =========================================================
   MONEY FORMATTER
========================================================= */

function formatMoney(value) {

    if (value >= 1000000000)
        return "$" + (value / 1000000000).toFixed(1) + "B";

    if (value >= 1000000)
        return "$" + (value / 1000000).toFixed(1) + "M";

    if (value >= 1000)
        return "$" + (value / 1000).toFixed(1) + "K";

    return "$" + Math.floor(value);

}


/* =========================================================
   UPGRADE MENU
========================================================= */

function toggleUpgrade() {

    const panel =
        document.getElementById("upgradePanel");

    if (panel.style.display === "block") {

        panel.style.display = "none";

    } else {

        panel.style.display = "block";

    }

}


/* =========================================================
   UPGRADE SYSTEM
========================================================= */

function buyUpgrade() {

    /*
        First purchase:
        $50 = unlock Auto Clicker

        Second purchase:
        $100 = first speed upgrade

        Every upgrade after:
        $150
    */

    if (!autoClickUnlocked) {

        if (money < 50) {

            alert("You need $50 to unlock Auto Clicker!");

            return;

        }

        money -= 50;

        autoClickUnlocked = true;

        document.getElementById("autoStatus").innerHTML =
            "Auto Clicker: ✅ Unlocked";

        document.getElementById("upgradeButton").textContent =
            "Speed Upgrade - $100";

        startAutoClicker();

        updateMoney();

        return;
    }


    /* Maximum speed */

    if (speed >= MAX_SPEED) {

        alert("MAXIMUM SPEED REACHED! 🚀");

        return;

    }


    /* First speed upgrade costs $100 */

    let price;

    if (upgradeLevel === 0) {

        price = 100;

    } else {

        price = 150;

    }


    if (money < price) {

        alert(
            "You need $" +
            price +
            " for this upgrade!"
        );

        return;

    }


    money -= price;

    speed += 0.5;

    upgradeLevel++;

    /*
        Prevent going over maximum.
    */

    if (speed > MAX_SPEED) {

        speed = MAX_SPEED;

    }


    updateMoney();

    updateSpeedDisplay();

    updateUpgradeButton();

}


/* =========================================================
   SPEED DISPLAY
========================================================= */

function updateSpeedDisplay() {

    document.getElementById("speed").textContent =
        formatSpeed(speed);

    document.getElementById("upgradeSpeed").textContent =
        formatSpeed(speed);

}


/* =========================================================
   SPEED FORMAT
========================================================= */

function formatSpeed(value) {

    if (value >= 1000) {

        return value.toLocaleString() + "×";

    }

    return value.toFixed(1).replace(".0", "") + "×";

}


/* =========================================================
   UPGRADE BUTTON UPDATE
========================================================= */

function updateUpgradeButton() {

    const button =
        document.getElementById("upgradeButton");


    if (speed >= MAX_SPEED) {

        button.textContent =
            "🚀 MAX SPEED";

        button.disabled = true;

        return;

    }


    let price;

    if (upgradeLevel === 0) {

        price = 100;

    } else {

        price = 150;

    }


    button.textContent =
        "⚡ Upgrade Speed - $" + price;

}


/* =========================================================
   AUTO CLICKER
========================================================= */

function startAutoClicker() {

    setInterval(() => {

        if (!autoClickUnlocked)
            return;


        /*
            Auto clicking becomes faster
            as your speed increases.

            At 1×:
            1 automatic click every second.

            At 2×:
            2 clicks per second.

            At higher levels:
            the interval becomes extremely small.
        */

        const earningsPerSecond =
            10 * speed;

        money += earningsPerSecond;

        updateMoney();

    }, 1000);

}


/* =========================================================
   SHOP
========================================================= */

function openShop() {

    document.getElementById("shop").style.display =
        "block";

}


function closeShop() {

    document.getElementById("shop").style.display =
        "none";

}


/* =========================================================
   CHARACTER PURCHASE
========================================================= */

function buyCharacter(name, price) {

    /*
        Already owned?
        Just equip them.
    */

    if (ownedCharacters.includes(name)) {

        equippedCharacter = name;

        document.getElementById("characterName").textContent =
            name;

        closeShop();

        return;

    }


    if (money < price) {

        alert(
            "You need $" +
            price.toLocaleString() +
            " to unlock " +
            name + "!"
        );

        return;

    }


    money -= price;

    ownedCharacters.push(name);

    equippedCharacter = name;

    document.getElementById("characterName").textContent =
        name;

    updateMoney();

    closeShop();


    alert(
        "🎉 " +
        name +
        " unlocked and equipped!"
    );

}


/* =========================================================
   FLOATING MONEY
========================================================= */

function createFloatingMoney(x, y, text) {

    const element =
        document.createElement("div");

    element.className =
        "floatingMoney";

    element.textContent =
        text;

    element.style.left =
        x + "px";

    element.style.top =
        y + "px";

    document.body.appendChild(element);


    setTimeout(() => {

        element.remove();

    }, 900);

}


/* =========================================================
   CLICK PARTICLES
========================================================= */

function createParticles(x, y) {

    for (let i = 0; i < 8; i++) {

        const particle =
            document.createElement("div");

        particle.className =
            "particle";

        particle.style.left =
            x + "px";

        particle.style.top =
            y + "px";


        const randomX =
            (Math.random() - 0.5) * 180;

        const randomY =
            (Math.random() - 0.5) * 180;


        particle.style.setProperty(
            "--x",
            randomX + "px"
        );

        particle.style.setProperty(
            "--y",
            randomY + "px"
        );


        document.body.appendChild(particle);


        setTimeout(() => {

            particle.remove();

        }, 700);

    }

}


/* =========================================================
   INITIALIZE
========================================================= */

updateMoney();

updateSpeedDisplay();

updateUpgradeButton();

</script>
</body>
